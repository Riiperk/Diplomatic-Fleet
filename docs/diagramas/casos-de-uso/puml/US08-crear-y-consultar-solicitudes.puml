@startuml US08
top to bottom direction
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #123A63
skinparam ActorBorderColor #123A63
skinparam ActorBackgroundColor #FFFFFF
skinparam RectangleBorderColor #123A63
skinparam RectangleBackgroundColor #F7FAFC
skinparam RectangleFontStyle bold
skinparam UsecaseBorderColor #123A63
skinparam UsecaseBackgroundColor #FFFFFF
skinparam UsecaseBackgroundColor<<Sistema>> #E8EEF5
skinparam UsecaseBorderColor<<Sistema>> #5B7A99
skinparam UsecaseBackgroundColor<<Relacionado>> #FFF4D6
skinparam UsecaseBorderColor<<Relacionado>> #B8860B
skinparam UsecaseBackgroundColor<<Principal>> #DCEBFA
skinparam UsecaseBorderWidth 1.5
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendBorderColor #123A63
skinparam NoteBackgroundColor #FFFBE6
skinparam NoteBorderColor #B8860B

title Figura 8. US08 - Crear y consultar solicitudes\nDiagrama de casos de uso
actor "Cliente\ninstitucional" as CLI
actor "Agente de\noperaciones" as AGE
rectangle "Sistema Diplomatic Fleet\n(Vue.js + API Spring Boot + PostgreSQL)" as SYS {
  usecase "US08\nCrear y consultar solicitudes" as UC <<Principal>>
  usecase "Consultar disponibilidad\n(US07)" as I1 <<Sistema>>
  usecase "Validar datos de la solicitud" as I2 <<Sistema>>
  usecase "Generar código y registrar\nestado RECIBIDA" as I3 <<Sistema>>
  usecase "Consultar estado\nde la solicitud" as E1
  usecase "US09 Validar conductor\nautorizado" as UC09 <<Relacionado>>
}
CLI -down- UC
UC -left- AGE : revisa
UC .down.> I1 : <<include>>
UC .down.> I2 : <<include>>
UC .down.> I3 : <<include>>
E1 .left.> UC : <<extend>>\n(punto: Listado de solicitudes)
UC09 .left.> UC : <<extend>>\n(punto: Modalidad SIN_CONDUCTOR)
legend bottom
  |= Campo |= Especificación |
  | Actor principal | Cliente institucional (crea y consulta); Agente de operaciones (revisa) |
  | Lo ejecuta el sistema | Validar datos, comprobar disponibilidad, generar código y guardar la solicitud |
  | Precondición | Cliente autenticado y activo; existe al menos un vehículo disponible |
  | Postcondición | Solicitud registrada en estado RECIBIDA |
  | Errores / alternos | 400 datos inválidos; 404 cliente o vehículo inexistente; 409 sin disponibilidad |
  | Estado en la entrega | Prototipo navegable |
  |= Relación y caso de uso |= Regla o condición |
  | <<include>> Consultar disponibilidad (US07) | Obligatorio, siempre se ejecuta. Solo se solicita un vehículo disponible |
  | <<include>> Validar datos de la solicitud | Obligatorio, siempre se ejecuta. Fechas, pasajeros, lugares y cliente activo |
  | <<include>> Generar código y registrar estado RECIBIDA | Obligatorio, siempre se ejecuta. Código único SOL-### |
  | <<extend>> Consultar estado de la solicitud | Opcional. Se ejecuta si el cliente o el agente consulta el seguimiento |
  | <<extend>> hacia este caso: US09 Validar conductor autorizado | Punto de extensión: Modalidad SIN_CONDUCTOR |
  Colores: azul = caso principal · gris = lo ejecuta el sistema (include) · blanco = opcional (extend) · amarillo = caso de otra historia
endlegend
@enduml
