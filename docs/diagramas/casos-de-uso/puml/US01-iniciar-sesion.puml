@startuml US01
top to bottom direction
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #123A63
skinparam ActorBorderColor #123A63
skinparam ActorBackgroundColor #FFFFFF
skinparam RectangleBorderColor #123A63
skinparam RectangleBackgroundColor #F7FAFC
skinparam RectangleFontStyle bold
skinparam UsecaseBorderColor #123A63
skinparam UsecaseBackgroundColor #FFFFFF
skinparam UsecaseBackgroundColor<<Sistema>> #E8EEF5
skinparam UsecaseBorderColor<<Sistema>> #5B7A99
skinparam UsecaseBackgroundColor<<Relacionado>> #FFF4D6
skinparam UsecaseBorderColor<<Relacionado>> #B8860B
skinparam UsecaseBackgroundColor<<Principal>> #DCEBFA
skinparam UsecaseBorderWidth 1.5
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendBorderColor #123A63
skinparam NoteBackgroundColor #FFFBE6
skinparam NoteBorderColor #B8860B

title Figura 1. US01 - Iniciar sesión\nDiagrama de casos de uso
actor "Administrador\ndel sistema" as ADM
actor "Cliente\ninstitucional" as CLI
actor "Agente de\noperaciones" as AGE
actor "Conductor\nprofesional" as CON
actor "Gestor\nde cobros" as COB
actor "Directivo /\nAuditor" as AUD
rectangle "Sistema Diplomatic Fleet\n(Vue.js + API Spring Boot + PostgreSQL)" as SYS {
  usecase "US01\nIniciar sesión" as UC <<Principal>>
  usecase "Validar formato de correo\ny contraseña" as I1 <<Sistema>>
  usecase "Verificar aceptación de\ntérminos y privacidad" as I2 <<Sistema>>
  usecase "Autenticar credenciales\ncontra el backend" as I3 <<Sistema>>
  usecase "Consultar términos de uso\ny política de privacidad" as E1
  usecase "Mostrar error de\nautenticación" as E2
}
ADM -down- UC
CLI -down- UC
AGE -down- UC
CON -down- UC
COB -down- UC
AUD -down- UC
UC .down.> I1 : <<include>>
UC .down.> I2 : <<include>>
UC .down.> I3 : <<include>>
E1 .left.> UC : <<extend>>\n(punto: Enlaces legales del login)
E2 .left.> UC : <<extend>>\n(punto: Respuesta de autenticación)
legend bottom
  |= Campo |= Especificación |
  | Actor principal | Cualquier rol (Administrador, Cliente, Agente, Conductor, Gestor de cobros, Directivo/Auditor) |
  | Lo ejecuta el sistema | Validaciones, autenticación, creación de la sesión temporal y redirección a /inicio |
  | Precondición | El usuario cuenta con credenciales de demostración autorizadas |
  | Postcondición | Sesión activa en sessionStorage y acceso al panel según el rol |
  | Errores / alternos | Correo inválido, contraseña corta, términos sin aceptar o credenciales incorrectas: no se permite el acceso |
  | Estado en la entrega | Funcional temporal (HTTP Basic); roles reales pendientes |
  |= Relación y caso de uso |= Regla o condición |
  | <<include>> Validar formato de correo y contraseña | Obligatorio, siempre se ejecuta. Correo válido y mínimo 8 caracteres |
  | <<include>> Verificar aceptación de términos y privacidad | Obligatorio, siempre se ejecuta. Casilla obligatoria antes de enviar |
  | <<include>> Autenticar credenciales contra el backend | Obligatorio, siempre se ejecuta. HTTP Basic temporal; 401 si no coinciden |
  | <<extend>> Consultar términos de uso y política de privacidad | Opcional. Se ejecuta si el usuario abre los enlaces legales |
  | <<extend>> Mostrar error de autenticación | Opcional. Se ejecuta si las credenciales son rechazadas (401) |
  Colores: azul = caso principal · gris = lo ejecuta el sistema (include) · blanco = opcional (extend) · amarillo = caso de otra historia
endlegend
@enduml
