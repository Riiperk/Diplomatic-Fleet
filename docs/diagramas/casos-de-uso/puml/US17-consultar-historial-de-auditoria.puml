@startuml US17
top to bottom direction
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #123A63
skinparam ActorBorderColor #123A63
skinparam ActorBackgroundColor #FFFFFF
skinparam RectangleBorderColor #123A63
skinparam RectangleBackgroundColor #F7FAFC
skinparam RectangleFontStyle bold
skinparam UsecaseBorderColor #123A63
skinparam UsecaseBackgroundColor #FFFFFF
skinparam UsecaseBackgroundColor<<Sistema>> #E8EEF5
skinparam UsecaseBorderColor<<Sistema>> #5B7A99
skinparam UsecaseBackgroundColor<<Relacionado>> #FFF4D6
skinparam UsecaseBorderColor<<Relacionado>> #B8860B
skinparam UsecaseBackgroundColor<<Principal>> #DCEBFA
skinparam UsecaseBorderWidth 1.5
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendBorderColor #123A63
skinparam NoteBackgroundColor #FFFBE6
skinparam NoteBorderColor #B8860B

title Figura 17. US17 - Consultar historial de auditoría\nDiagrama de casos de uso
actor "Directivo /\nAuditor" as AUD
actor "Administrador\ndel sistema" as ADM
rectangle "Sistema Diplomatic Fleet\n(Vue.js + API Spring Boot + PostgreSQL)" as SYS {
  usecase "US17\nConsultar historial de auditoría" as UC <<Principal>>
  usecase "Validar permisos de\nauditoría" as I1 <<Sistema>>
  usecase "Consultar registros de auditoría" as I2 <<Sistema>>
  usecase "Filtrar por usuario,\nfecha o acción" as E1
  usecase "Exportar historial" as E2
}
AUD -down- UC
UC -left- ADM : también puede consultar
UC .down.> I1 : <<include>>
UC .down.> I2 : <<include>>
E1 .left.> UC : <<extend>>\n(punto: Listado de auditoría)
E2 .left.> UC : <<extend>>\n(punto: Listado de auditoría)
legend bottom
  |= Campo |= Especificación |
  | Actor principal | Directivo / Auditor |
  | Lo ejecuta el sistema | Registrar automáticamente cada acción y servir la consulta de solo lectura |
  | Precondición | Auditor autenticado; acciones previamente registradas |
  | Postcondición | Historial mostrado; los registros no se pueden editar |
  | Errores / alternos | 403 sin permisos; lista vacía si no hay registros |
  | Estado en la entrega | Pendiente (backlog) |
  |= Relación y caso de uso |= Regla o condición |
  | <<include>> Validar permisos de auditoría | Obligatorio, siempre se ejecuta. Solo Auditor y Administrador |
  | <<include>> Consultar registros de auditoría | Obligatorio, siempre se ejecuta. Usuario, acción, entidad y fecha |
  | <<extend>> Filtrar por usuario, fecha o acción | Opcional. Se ejecuta si se aplican criterios de búsqueda |
  | <<extend>> Exportar historial | Opcional. Se ejecuta si se solicita la descarga |
  Colores: azul = caso principal · gris = lo ejecuta el sistema (include) · blanco = opcional (extend) · amarillo = caso de otra historia
endlegend
@enduml
