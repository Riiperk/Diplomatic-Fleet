@startuml US16
top to bottom direction
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #123A63
skinparam ActorBorderColor #123A63
skinparam ActorBackgroundColor #FFFFFF
skinparam RectangleBorderColor #123A63
skinparam RectangleBackgroundColor #F7FAFC
skinparam RectangleFontStyle bold
skinparam UsecaseBorderColor #123A63
skinparam UsecaseBackgroundColor #FFFFFF
skinparam UsecaseBackgroundColor<<Sistema>> #E8EEF5
skinparam UsecaseBorderColor<<Sistema>> #5B7A99
skinparam UsecaseBackgroundColor<<Relacionado>> #FFF4D6
skinparam UsecaseBorderColor<<Relacionado>> #B8860B
skinparam UsecaseBackgroundColor<<Principal>> #DCEBFA
skinparam UsecaseBorderWidth 1.5
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendBorderColor #123A63
skinparam NoteBackgroundColor #FFFBE6
skinparam NoteBorderColor #B8860B

title Figura 16. US16 - Modificar o cancelar solicitud antes de confirmación\nDiagrama de casos de uso
actor "Cliente\ninstitucional" as CLI
rectangle "Sistema Diplomatic Fleet\n(Vue.js + API Spring Boot + PostgreSQL)" as SYS {
  usecase "US16\nModificar o cancelar solicitud antes de confirmación" as UC <<Principal>>
  usecase "Validar que la solicitud\nsea del cliente" as I1 <<Sistema>>
  usecase "Validar estado permitido" as I2 <<Sistema>>
  usecase "Registrar cambio\nen auditoría" as I3 <<Sistema>>
  usecase "Modificar solicitud" as E1
  usecase "Cancelar solicitud" as E2
  usecase "US07 Consultar disponibilidad" as UC07 <<Relacionado>>
}
CLI -down- UC
UC .down.> I1 : <<include>>
UC .down.> I2 : <<include>>
UC .down.> I3 : <<include>>
E1 .left.> UC : <<extend>>\n(punto: Edición de solicitud)
E2 .left.> UC : <<extend>>\n(punto: Cancelación de solicitud)
UC07 .left.> UC : <<extend>>\n(punto: Cambio de fechas)
legend bottom
  |= Campo |= Especificación |
  | Actor principal | Cliente institucional |
  | Lo ejecuta el sistema | Verificar propiedad y estado, aplicar el cambio y liberar el vehículo si se cancela |
  | Precondición | Solicitud existente antes de la aprobación |
  | Postcondición | Solicitud modificada (se revalida disponibilidad) o CANCELADA |
  | Errores / alternos | 409 solicitud ya aprobada; 404 solicitud inexistente; 403 solicitud ajena |
  | Estado en la entrega | Pendiente (backlog) |
  |= Relación y caso de uso |= Regla o condición |
  | <<include>> Validar que la solicitud sea del cliente | Obligatorio, siempre se ejecuta. No se acceden solicitudes ajenas |
  | <<include>> Validar estado permitido | Obligatorio, siempre se ejecuta. Solo RECIBIDA, EN_REVISION o COTIZADA |
  | <<include>> Registrar cambio en auditoría | Obligatorio, siempre se ejecuta. Acción, usuario y fecha |
  | <<extend>> Modificar solicitud | Opcional. Se ejecuta si el cliente cambia fechas, lugares o pasajeros |
  | <<extend>> Cancelar solicitud | Opcional. Se ejecuta si el cliente decide cancelar |
  | <<extend>> hacia este caso: US07 Consultar disponibilidad | Punto de extensión: Cambio de fechas |
  Colores: azul = caso principal · gris = lo ejecuta el sistema (include) · blanco = opcional (extend) · amarillo = caso de otra historia
endlegend
@enduml
