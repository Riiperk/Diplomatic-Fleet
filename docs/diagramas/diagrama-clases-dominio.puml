@startuml DiplomaticFleet_DiagramaClases_Normalizado

title Diagrama de Clases Normalizado - Diplomatic Fleet\nAlquiler de vehículos para clientes diplomáticos e institucionales

' =========================================================
' CONFIGURACIÓN VISUAL PROFESIONAL
' =========================================================

' Orientación general: núcleo superior y módulos debajo
top to bottom direction

skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam titleFontSize 18
skinparam titleFontStyle bold
skinparam classFontSize 13
skinparam classAttributeFontSize 10
skinparam classStereotypeFontSize 9
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam packageFontSize 13
skinparam packageFontStyle bold
skinparam linetype ortho

' Espaciado: evita cajas amontonadas y facilita seguir relaciones
skinparam nodesep 55
skinparam ranksep 75
skinparam dpi 220

skinparam class {
    BackgroundColor white
    BorderColor black
    ArrowColor black
    FontColor black
    AttributeFontColor black
    StereotypeFontColor black
}

skinparam package {
    BackgroundColor white
    BorderColor black
    FontColor black
}

skinparam note {
    BackgroundColor white
    BorderColor black
    FontColor black
}

hide circle
hide methods

' =========================================================
' NÚCLEO MOSTRADO POR EL PROFESOR
' =========================================================

package "Personas, perfiles y registro" {

    class "TipoDocumento" as TipoDocumento <<catalogo>> {
        +idTipoDocumento: Long {PK}
        --
        codigo: String {UK}
        nombre: String
        descripcion: String
        longitudMinima: Integer
        longitudMaxima: Integer
        requiereFechaExpedicion: Boolean
        aplicaPersonaNatural: Boolean
        activo: Boolean
        creadoEn: DateTime
        actualizadoEn: DateTime
    }

    class "Persona" as Persona <<entidad>> {
        +idPersona: Long {PK}
        --
        idTipoDocumento: Long {FK}
        primerNombre: String
        segundoNombre: String {opcional}
        primerApellido: String
        segundoApellido: String {opcional}
        numeroDocumento: String
        fechaExpedicionDocumento: Date {opcional}
        fechaNacimiento: Date
        activo: Boolean
        creadoEn: DateTime
        actualizadoEn: DateTime
    }

    class "DatosAdicionalesPersona" as DatosAdicionales <<entidad>> {
        +idDatosAdicionales: Long {PK}
        --
        idPersona: Long {FK, UK}
        indicativoTelefonico: String
        numeroTelefono: String
        extensionTelefonica: String {opcional}
        correoElectronico: String {UK}
        tipoVia: String
        numeroVia: String
        letraVia: String {opcional}
        numeroPredio: String
        numeroComplemento: String
        complementoDireccion: String {opcional}
        barrio: String {opcional}
        municipio: String
        departamento: String
        codigoPostal: String {opcional}
        ocupacion: String {opcional}
        nacionalidad: String {opcional}
        idiomaPreferido: String
        medioContactoPreferido: String
        recibeNotificaciones: Boolean
        aceptaTratamientoDatos: Boolean
        fechaAceptacionDatos: DateTime {opcional}
        observaciones: String {opcional}
        edad: Integer {derivado}
        creadoEn: DateTime
        actualizadoEn: DateTime
    }

    class "Perfil" as Perfil <<catalogo>> {
        +idPerfil: Long {PK}
        --
        codigo: String {UK}
        nombre: String
        descripcion: String
        nivelAcceso: Integer
        esAdministrativo: Boolean
        permiteGestionUsuarios: Boolean
        permiteGestionFlota: Boolean
        permiteGestionServicios: Boolean
        activo: Boolean
        creadoEn: DateTime
        actualizadoEn: DateTime
    }

    class "Usuario" as Usuario <<entidad>> {
        +idUsuario: Long {PK}
        --
        idPersona: Long {FK, UK}
        idPerfil: Long {FK}
        nombreUsuario: String {UK}
        contrasenaHash: String
        ultimoAcceso: DateTime {opcional}
        intentosFallidos: Integer
        bloqueadoHasta: DateTime {opcional}
        requiereCambioContrasena: Boolean
        aceptoTerminos: Boolean
        fechaAceptacionTerminos: DateTime {opcional}
        activo: Boolean
        creadoEn: DateTime
        actualizadoEn: DateTime
    }

    class "FormularioRegistro" as FormularioRegistro <<boundary>> {
        primerNombre: String
        segundoNombre: String {opcional}
        primerApellido: String
        segundoApellido: String {opcional}
        tipoDocumentoSeleccionado: Long
        numeroDocumento: String
        fechaExpedicionDocumento: Date {opcional}
        fechaNacimiento: Date
        indicativoTelefonico: String
        numeroTelefono: String
        correoElectronico: String
        tipoVia: String
        numeroVia: String
        numeroPredio: String
        numeroComplemento: String
        municipio: String
        departamento: String
        perfilSeleccionado: Long
        nombreUsuario: String
        contrasena: String
        confirmacionContrasena: String
        terminosAceptados: Boolean
    }

    class "ServicioRegistro" as ServicioRegistro <<control>> {
        idOperacion: UUID
        fechaEjecucion: DateTime
        origenSolicitud: String
        registroExitoso: Boolean
        mensajeResultado: String
        idPersonaCreada: Long {opcional}
        idUsuarioCreado: Long {opcional}
        duracionMilisegundos: Long
        requiereAuditoria: Boolean
        creadoEn: DateTime
    }
}

' =========================================================
' PERMISOS Y SESIONES
' =========================================================

package "Seguridad y autorización" {

    class "Permiso" as Permiso <<catalogo>> {
        +idPermiso: Long {PK}
        --
        codigo: String {UK}
        nombre: String
        descripcion: String
        modulo: String
        recurso: String
        accion: String
        metodoHttp: String
        activo: Boolean
        creadoEn: DateTime
        actualizadoEn: DateTime
    }

    class "PerfilPermiso" as PerfilPermiso <<asociativa>> {
        +idPerfilPermiso: Long {PK}
        --
        idPerfil: Long {FK}
        idPermiso: Long {FK}
        fechaAsignacion: DateTime
        asignadoPor: String
        fechaRevocacion: DateTime {opcional}
        revocadoPor: String {opcional}
        motivoRevocacion: String {opcional}
        activo: Boolean
        creadoEn: DateTime
        actualizadoEn: DateTime
    }

    class "SesionUsuario" as SesionUsuario <<entidad>> {
        +idSesion: UUID {PK}
        --
        idUsuario: Long {FK}
        tokenHash: String {UK}
        direccionIp: String
        agenteUsuario: String
        fechaInicio: DateTime
        fechaExpiracion: DateTime
        fechaUltimaActividad: DateTime
        fechaCierre: DateTime {opcional}
        motivoCierre: String {opcional}
        activa: Boolean
    }
}

' =========================================================
' CLIENTES INSTITUCIONALES
' =========================================================

