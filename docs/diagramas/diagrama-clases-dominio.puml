        actualizadoEn: DateTime
    }

    class "EstadoVehiculo" as EstadoVehiculo <<catalogo>> {
        +idEstadoVehiculo: Long {PK}
        --
        codigo: String {UK}
        nombre: String
        descripcion: String
        permiteReserva: Boolean
        exigeMantenimiento: Boolean
        esEstadoOperativo: Boolean
        activo: Boolean
