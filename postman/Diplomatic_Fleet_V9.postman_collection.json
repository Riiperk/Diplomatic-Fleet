    {
      "name": "02 · Pruebas con escritura (ejecutar consciente)",
      "item": [
        {
          "name": "Registrar cliente institucional (crea registros)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/registro",
            "description": "⚠ Genera una institución y un usuario reales. Usa nombreEntidad y clientEmail nuevos; deja la contraseña en tu environment local, no la compartas.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cliente\",\n  \"apellido\": \"Prueba\",\n  \"correo\": \"{{clientEmail}}\",\n  \"password\": \"{{clientPassword}}\",\n  \"nombreEntidad\": \"{{nombreEntidad}}\",\n  \"tipoEntidad\": \"EMBAJADA\",\n  \"telefono\": \"3000000000\",\n  \"ciudad\": \"Bogotá\",\n  \"direccion\": \"Carrera 10 # 20-30\",\n  \"numeroIdentificacionFiscal\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta esperada\", function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
                  "if(pm.response.code<300){const data=pm.response.json();pm.environment.set(\"clienteInstitucionalId\",data.clienteInstitucionalId);pm.test(\"Rol cliente\",()=>pm.expect(data.rol).to.eql(\"CLIENTE\"));}"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear solicitud de alquiler (genera reserva)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/solicitudes",
            "description": "⚠ Escribe en PostgreSQL. Primero ejecuta el catálogo público para almacenar vehiculoId.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{clientEmail}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{clientPassword}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehiculoId\": {{vehiculoId}},\n  \"inicio\": \"{{inicioISO}}\",\n  \"fin\": \"{{finISO}}\",\n  \"recogida\": \"Aeropuerto El Dorado, Bogotá\",\n  \"devolucion\": \"Centro de Bogotá\",\n  \"pasajeros\": 2,\n  \"observaciones\": \"Prueba funcional académica\",\n  \"metodoPago\": \"TRANSFERENCIA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Calcula fechas futuras para evitar tener que actualizar el ejemplo cada día.",
                  "const d=new Date();d.setDate(d.getDate()+2);d.setHours(14,0,0,0);",
                  "const fin=new Date(d);fin.setDate(fin.getDate()+2);",
                  "pm.environment.set(\"inicioISO\",d.toISOString());",
                  "pm.environment.set(\"finISO\",fin.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta esperada\", function () { pm.expect(pm.response.code).to.be.oneOf([201]); });",
                  "if(pm.response.code===201){pm.environment.set(\"reservaId\",pm.response.json().id);}"
                ]
              }
            }
          ]
        },
        {
          "name": "Aprobar solicitud (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/solicitudes/{{reservaId}}/estado",
            "description": "⚠ Cambia el estado de la reserva. Solo después de crearla; confirma desde RECIBIDA o EN_REVISION.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{adminEmail}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{adminPassword}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"CONFIRMADA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta esperada\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Rechazar solicitud (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/solicitudes/{{reservaId}}/estado",
            "description": "⚠ Alternativa a Aprobar, no ejecutar ambas sobre la misma reserva.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
