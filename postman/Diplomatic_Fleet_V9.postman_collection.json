                ]
              }
            }
          ]
        },
        {
          "name": "Cancelar solicitud (cliente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/solicitudes/{{reservaId}}/cancelar",
            "description": "⚠ Alternativa al aprobar. Permitida solo en estados elegibles.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{clientEmail}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{clientPassword}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"Cambio de planes institucionales\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
