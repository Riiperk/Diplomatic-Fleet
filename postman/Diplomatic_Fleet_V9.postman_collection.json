  "item": [
    {
      "name": "01 · Consultas seguras",
      "item": [
        {
          "name": "Consultar catálogo público",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/public/vehiculos",
            "description": "No requiere autenticación; devuelve únicamente vehículos activos, disponibles y con precio.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta esperada\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "pm.test(\"Catálogo en formato JSON\",()=>pm.expect(pm.response.json()).to.be.an(\"array\"));",
                  "const cars=pm.response.json();if(cars.length){pm.environment.set(\"vehiculoId\",cars[0].id);}"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar catálogo por fechas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/public/vehiculos?inicio={{inicioISO}}&fin={{finISO}}",
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Calcula fechas futuras para evitar tener que actualizar el ejemplo cada día.",
                  "const d=new Date();d.setDate(d.getDate()+2);d.setHours(14,0,0,0);",
                  "const fin=new Date(d);fin.setDate(fin.getDate()+2);",
                  "pm.environment.set(\"inicioISO\",d.toISOString());",
                  "pm.environment.set(\"finISO\",fin.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta esperada\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "pm.test(\"Consulta por fechas\",()=>pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
